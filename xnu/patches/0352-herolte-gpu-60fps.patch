+uint32_t
+herolte_gpu_submit_batch(const uint64_t *pairs, unsigned count, uint64_t *us)
+{
+	if (pairs == NULL || count == 0 || count > 64) {
+		return ~0u;
+	}
+	lck_mtx_lock(hg_mtx);
+	uint32_t status = ~0u;
+	if (hg_up_state == 1) {
+		uint64_t start = mach_absolute_time();
+		hg_affinity = hg_rd(hg_gpu, SHADER_PRESENT_LO);
+		hg_job_cpu = 0;
+		hg_run_quiet = true;
+		hg_run_nap = true;
+		status = 0;
+		for (unsigned i = 0; i < count; i++) {
+			uint64_t jc = pairs[2 * i];
+			unsigned js = pairs[2 * i + 1] ? 1u : 0u;
+			if (jc == 0) {
+				continue;
+			}
+			hg_job_va = jc;
+			bool ok = hg_run(js, js ? "HEROGPU batch JS1" : "HEROGPU batch JS0");
+			if (!ok && status == 0) {
+				status = hg_last_js_status ? hg_last_js_status : ~0u;
+			}
+		}
+		hg_run_nap = false;
+		hg_run_quiet = false;
+		hg_job_va = HG_TEST_VA;
+		hg_affinity = 1;
+		if (us) {
+			*us = hg_us_since(start);
+		}
+	}
+	lck_mtx_unlock(hg_mtx);
+	return status;
+}
