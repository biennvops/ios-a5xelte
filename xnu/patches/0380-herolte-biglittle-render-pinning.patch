+void
+herolte_gpu_pin_render_big(void)
+{
+	extern struct processor *cpu_to_processor(int cpu);
+	extern struct processor *thread_bind(struct processor *processor);
+	uint32_t on = 1;
+	PE_parse_boot_argn("herogpu_bind", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	struct processor *big = cpu_to_processor(4); /* first Exynos M1 Mongoose big core */
+	if (big != NULL) {
+		(void)thread_bind(big);
+		printf("HEROLTE GPU: pinned backboardd render thread to Mongoose cpu 4\n");
+	}
+}
+
+void
+herolte_gpu_pin_little(int cpu)
+{
+	extern struct processor *cpu_to_processor(int cpu);
+	extern struct processor *thread_bind(struct processor *processor);
+	uint32_t on = 1;
+	PE_parse_boot_argn("herogpu_bind", &on, sizeof(on));
+	if (!on || cpu < 0 || cpu > 3) {
+		return;
+	}
+	struct processor *little = cpu_to_processor(cpu);
+	if (little != NULL) {
+		(void)thread_bind(little);
+	}
+}
