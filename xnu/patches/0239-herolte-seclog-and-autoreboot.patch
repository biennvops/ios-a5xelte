@@ -634,6 +634,101 @@ struct herolte_log_header {
 };
 
 static int herolte_log_chan;
+static vm_offset_t herolte_seclog_va;
+static vm_offset_t herolte_pmu_va;
+
+void herolte_seclog_sync(void);
+void herolte_reboot_recovery(void);
+extern void sweet_usb_probe(void);
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+uint64_t sweet_log_position(void);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	const char *ring;
+	uint32_t ring_sz;
+	uint64_t ring_tot;
+	a5xelte_log_snapshot(&ring, &ring_sz, &ring_tot);
+	if (!ring || !ring_sz) {
+		return 0;
+	}
+	if (ring_tot - *pos > ring_sz) {
+		*pos = ring_tot - ring_sz;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, ring_tot - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = ring[(*pos + i) % ring_sz];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t
+sweet_log_position(void)
+{
+	const char *ring;
+	uint32_t ring_sz;
+	uint64_t ring_tot;
+	a5xelte_log_snapshot(&ring, &ring_sz, &ring_tot);
+	return ring_tot;
+}
+
+void
+herolte_seclog_sync(void)
+{
+	const char *ring;
+	uint32_t ring_sz;
+	uint64_t ring_tot;
+
+	if (!herolte_seclog_va) {
+		herolte_seclog_va = ml_io_map(0x91a00000u, 0x200000u);
+		if (!herolte_seclog_va) {
+			return;
+		}
+	}
+	a5xelte_log_snapshot(&ring, &ring_sz, &ring_tot);
+	if (!ring || !ring_sz || !ring_tot) {
+		return;
+	}
+	volatile char *dst = (volatile char *)herolte_seclog_va;
+	static const char hdr[] = "\n=== HEROLOG SEC_LOG START ===\n";
+	static const char ftr[] = "\n=== HEROLOG SEC_LOG END ===\n";
+	uint32_t max_copy = 0x1e0000u;
+	uint64_t n = MIN(ring_tot, (uint64_t)max_copy);
+	uint64_t start = ring_tot - n;
+	uint32_t off = 0;
+	for (unsigned i = 0; i < sizeof(hdr) - 1; i++) {
+		dst[off++] = hdr[i];
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		dst[off++] = ring[(start + i) % ring_sz];
+	}
+	for (unsigned i = 0; i < sizeof(ftr) - 1; i++) {
+		dst[off++] = ftr[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+herolte_reboot_recovery(void)
+{
+	printf("HEROLTE: syncing sec_log and rebooting to TWRP recovery\n");
+	herolte_seclog_sync();
+	if (!herolte_pmu_va) {
+		herolte_pmu_va = ml_io_map(0x105c0000u, 0x1000u);
+	}
+	if (herolte_pmu_va) {
+		*(volatile uint32_t *)(herolte_pmu_va + 0x808u) = 0x12345678u;
+		*(volatile uint32_t *)(herolte_pmu_va + 0x80cu) = 0x12345674u;
+		__asm__ volatile("dsb sy" ::: "memory");
+		*(volatile uint32_t *)(herolte_pmu_va + 0x400u) = 1u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
 
