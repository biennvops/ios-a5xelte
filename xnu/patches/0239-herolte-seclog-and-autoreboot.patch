diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index 9b46983..1d08139 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -634,6 +634,72 @@ struct herolte_log_header {
 };
 
 static int herolte_log_chan;
+static vm_offset_t herolte_seclog_va;
+static vm_offset_t herolte_pmu_va;
+
+void herolte_seclog_sync(void);
+void herolte_reboot_recovery(void);
+
+/*
+ * Exynos 8890 sec_debug log_kernel (phys 0x91a00000, 2 MiB): TWRP saves this
+ * region to /proc/last_kmsg on boot. Mirroring the XNU console ring here lets
+ * TWRP read the kernel log without touching UFS.
+ */
+void
+herolte_seclog_sync(void)
+{
+	const char *ring;
+	uint32_t rsize;
+	uint64_t total;
+
+	if (!herolte_seclog_va) {
+		herolte_seclog_va = ml_io_map(0x91a00000u, 0x200000u);
+		if (!herolte_seclog_va) {
+			return;
+		}
+	}
+	a5xelte_log_snapshot(&ring, &rsize, &total);
+	if (!ring || !rsize || !total) {
+		return;
+	}
+	volatile char *dst = (volatile char *)herolte_seclog_va;
+	static const char hdr[] = "\n=== HEROLOG SEC_LOG START ===\n";
+	static const char ftr[] = "\n=== HEROLOG SEC_LOG END ===\n";
+	uint32_t max_copy = 0x1e0000u;
+	uint64_t n = MIN(total, (uint64_t)max_copy);
+	uint64_t start = total - n;
+	uint32_t off = 0;
+	for (unsigned i = 0; i < sizeof(hdr) - 1; i++) {
+		dst[off++] = hdr[i];
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		dst[off++] = ring[(start + i) % rsize];
+	}
+	for (unsigned i = 0; i < sizeof(ftr) - 1; i++) {
+		dst[off++] = ftr[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+herolte_reboot_recovery(void)
+{
+	printf("HEROLTE: syncing sec_log and rebooting to TWRP recovery\n");
+	herolte_seclog_sync();
+	if (!herolte_pmu_va) {
+		herolte_pmu_va = ml_io_map(0x105c0000u, 0x1000u);
+	}
+	if (herolte_pmu_va) {
+		*(volatile uint32_t *)(herolte_pmu_va + 0x808u) = 0x12345678u;
+		*(volatile uint32_t *)(herolte_pmu_va + 0x80cu) = 0x12345674u;
+		__asm__ volatile("dsb sy" ::: "memory");
+		*(volatile uint32_t *)(herolte_pmu_va + 0x400u) = 1u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
 
