 		return;
 	}
 	if (kernel_thread_start(herolte_log_thread, NULL, &thread) == KERN_SUCCESS) {
@@ -875,6 +950,14 @@ herolte_ufs_probe(void)
 	}
 	lck_mtx_unlock(&herolte_ufs_lock);
 	printf("HEROLTE UFS: probe done (%d)\n", error);
+	herolte_seclog_sync();
