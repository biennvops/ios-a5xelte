+uint64_t
+herolte_gpu_enqueue_batch(const uint64_t *pairs, unsigned count, uint64_t *done_out, uint64_t *gpu_us_out)
+{
+	if (count > 64) {
+		return 0;
+	}
+	if (count > 0) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	lck_mtx_lock(hg_q_mtx);
+	if (count > 0 && !hg_q_started) {
+		thread_t th = THREAD_NULL;
+		if (kernel_thread_start(hg_worker_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+			__atomic_store_n(&hg_q_started, true, __ATOMIC_RELEASE);
+			printf("HEROLTE GPU: kernel FIFO worker started (%u slots, batch)
+", HG_Q_SIZE);
+		} else {
+			lck_mtx_unlock(hg_q_mtx);
+			return 0;
+		}
+	}
+	uint64_t seq = hg_q_tail;
+	for (unsigned i = 0; i < count; i++) {
+		uint64_t jc = pairs[2 * i];
+		unsigned js = pairs[2 * i + 1] ? 1u : 0u;
+		if (jc == 0) {
+			continue;
+		}
+		while (hg_q_tail - hg_q_done >= HG_Q_SIZE) {
+			(void)lck_mtx_sleep(hg_q_mtx, LCK_SLEEP_DEFAULT, (event_t)&hg_q_done_ev, THREAD_UNINT);
+		}
+		hg_q[hg_q_tail % HG_Q_SIZE].jc = jc;
+		hg_q[hg_q_tail % HG_Q_SIZE].js = (uint8_t)js;
+		seq = hg_q_tail + 1;
+		__atomic_store_n(&hg_q_tail, seq, __ATOMIC_RELEASE);
+	}
+	uint64_t done = hg_q_done;
+	uint64_t tus = hg_q_gpu_us;
+	if (count > 0) {
+		thread_wakeup((event_t)&hg_q_work_ev);
+	}
+	lck_mtx_unlock(hg_q_mtx);
+	if (done_out) {
+		*done_out = done;
+	}
+	if (gpu_us_out) {
+		*gpu_us_out = tus;
+	}
+	return seq;
+}
