+/* One charger register byte, and a verify-after-write update. */
+static bool
+chg_byte(uint8_t reg, uint8_t *value)
+{
+	uint8_t b;
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		if (fg_message(CHG_ADDR, false, &reg, 1, false) &&
+		    fg_message(CHG_ADDR, true, &b, 1, true)) {
+			*value = b;
+			return true;
+		}
+		delay(500);
+	}
+	return false;
+}
+
+/* A register write is one fg_message() with both bytes: reg and value in the
+ * same transaction (AUTO_CONF carries the 2-byte count). */
+static bool
+fg_write_reg(uint8_t addr, uint8_t reg, uint8_t value)
+{
+	uint8_t msg[2] = { reg, value };
+	return fg_message(addr, false, msg, 2, true);
+}
+
+/*
+ * Read-modify-write with the state logged. The setting-protect (CNFG_06 bits
+ * 3:2) is re-written before every register: on this PMIC a parameter write
+ * re-locks, and the registers it guards (b0 modes, b2 current, b3 top-off,
+ * b5 OCP) then silently drop the next write (observed in the register dump).
+ */
+static bool
+chg_update(uint8_t reg, uint8_t value, uint8_t mask)
+{
+	uint8_t old;
+	if (!chg_byte(reg, &old)) {
+		return false;
+	}
+	uint8_t b = (uint8_t)((old & ~mask) | (value & mask));
+	if (!fg_write_reg(CHG_ADDR, CHG_CNFG_06, 0x0c) ||
+	    !fg_write_reg(CHG_ADDR, reg, b)) {
+		printf("HEROLTE CHG: write %#x to CNFG %#x failed\n", b, reg);
+		return false;
+	}
+	uint8_t back;
+	(void)chg_byte(reg, &back);
+	printf("HEROLTE CHG: CNFG %#x %#x -> %#x\n", reg, old, back);
+	return back == b;
+}
+
+/*
+ * HEROLTE charger (Linux max77854_charger_initialize, minus the watchdog,
+ * which needs a userspace kicker XNU has none of). With CHG and BUCK on,
+ * the PMIC charges from VBUS whenever a cable is present; the fuel gauge's
+ * CURRENT then reads positive, which SweetBattery already reports as
+ * "charging". Boot-arg herochg=0 leaves the PMIC as the bootloader had it.
+ */
+int
+herolte_chg_init(void)
+{
+	int enabled = 1;
+	PE_parse_boot_argn("herochg", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return -1;
+	}
+	uint8_t id;
+	if (!chg_byte(CHG_CNFG_00, &id)) {
+		printf("HEROLTE CHG: no answer at 0x69\n");
+		return -1;
+	}
+	printf("HEROLTE CHG: 0x69 answers, CNFG_00=%#x\n", id);
+	/* Timers: fast-charge timer, restart threshold and pre-qual charge off
+	 * (CNFG_01), top-off 150 mA / 70 min (CNFG_03), as Linux has them. */
+	(void)chg_update(CHG_CNFG_01, (uint8_t)((0x03 << 4) | 0x08), 0xff);
+	(void)chg_update(CHG_CNFG_03, 0x38, 0xff);
+	/* Charge current 466 mA (CNFG_02 default bits), OTG limit 900 mA (bits 6-7). */
+	(void)chg_update(CHG_CNFG_02, 0x01 << 6, 0xc0);
+	/* BAT-to-SYS OCP 5.00 A (CNFG_05 bits 0-2, as Linux). */
+	(void)chg_update(CHG_CNFG_05, 0x05, 0x07);
+	/* Input current limit (AICR) 500 mA: a plain USB port is the worst case. */
+	(void)chg_update(CHG_CNFG_09, 0x05, 0x7f);
+	/* CHG_EN (0x01) and BUCK (0x04) on, the watchdog (0x08) off: no userspace
+	 * kicker runs under XNU, so it would stop charging minutes in. CNFG_00
+	 * read-back is not stable on this device (0x2, 0xe1, 0x0 across one boot),
+	 * so the write is trusted and DETAILS_01 (0xBA) reports the true state. */
+	(void)chg_update(CHG_CNFG_00, 0x05, 0x0f);
+	uint8_t dtls;
+	if (!chg_byte(CHG_DETAILS_01, &dtls)) {
+		printf("HEROLTE CHG: DETAILS_01 unreadable\n");
+		return -1;
+	}
+	printf("HEROLTE CHG: init done, DETAILS_01=%#x (chg_dtls=%#x)\n",
+	    dtls, (dtls >> 4) & 0x0f);
+	/* All registers, twice: one read may catch a NAK (all ones). */
+	for (uint8_t pass = 0; pass < 2; pass++) {
+		char line[160];
+		int n = snprintf(line, sizeof(line), "HEROLTE CHG: regs[%u]", pass);
+		for (uint8_t reg = 0xB0; reg <= 0xC3 && n < (int)sizeof(line) - 6; reg++) {
+			uint8_t v;
+			n += snprintf(line + n, sizeof(line) - n, " %02x=%02x",
+			    reg, chg_byte(reg, &v) ? v : 0xffu);
+		}
+		printf("%s\n", line);
+		delay(100);
+	}
+	return 0;
+}
+
+/* CHG_DTLS (DETAILS_01 bits 4-7): 1 pre-charge, 2 fast, 3 top-off, 4 done. */
+bool
+herolte_chg_active(void)
+{
+	uint8_t dtls;
+	if (!chg_byte(CHG_DETAILS_01, &dtls)) {
+		return false;
+	}
+	uint8_t chg = (uint8_t)((dtls >> 4) & 0x0f);
+	return chg >= 1 && chg <= 4;
+}
