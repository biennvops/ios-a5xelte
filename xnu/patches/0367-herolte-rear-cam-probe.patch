+SYSCTL_STRING(_kern, OID_AUTO, notefe_cam_rear, CTLFLAG_RD | CTLFLAG_LOCKED, nc_rear_info, sizeof(nc_rear_info), "Rear camera Stage 1 probe result");
 static void nc_dev_make(void);
 
