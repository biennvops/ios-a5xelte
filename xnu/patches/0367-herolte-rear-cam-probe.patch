 static void
 notefe_cam_csis_look(void)
 {
@@ -3167,7 +3287,7 @@ notefe_cam_sysctl SYSCTL_HANDLER_ARGS
 	if (!kauth_cred_issuser(kauth_cred_get())) {
 		return EPERM;
 	}
-	if (value < 1 || value > 7) {
+	if (value < 1 || value > 9) {
 		return EINVAL;
 	}
 	notefe_cam_last = value;
