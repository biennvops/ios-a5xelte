@@ -3508,7 +3519,8 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 	uint64_t last_log = 0;
 	int top = -1000, seen_max = -1000;
 	for (;;) {
-		hg_msleep(200);
+		assert_wait_timeout((event_t)&hg_power_ev, THREAD_UNINT, 200, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
 		uint64_t now = mach_absolute_time(), off = herolte_screen_off_at, ns = 0;
 		if (off != 0 && now > off) {
 			absolutetime_to_nanoseconds(now - off, &ns);
@@ -3590,6 +3602,11 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 				idle_low = !hc.high;         /* no ticks: keep the state */
 			}
 		}
+		bool touch_boost = !screen_off && now < __atomic_load_n(&hg_touch_boost_until, __ATOMIC_ACQUIRE);
+		if (touch_boost) {
+			idle_low = false;
+			gov_quiet_ms = 0;
+		}
 		int want = (screen_off || idle_low || heat_step >= 4) ? 4 : heat_step;
 		if (!hc.broken && want != rate) {
 			bool ok = hc_go(want, &rate);
