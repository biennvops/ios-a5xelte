+void
+herolte_touch_boost(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(2000, NSEC_PER_MSEC, &deadline);
+	__atomic_store_n(&hg_touch_boost_until, deadline, __ATOMIC_RELEASE);
+	thread_wakeup((event_t)&hg_power_ev);
+}        /* mach time the display went off; 0 while it is on */
