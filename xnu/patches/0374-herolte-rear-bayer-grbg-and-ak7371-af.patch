+/*
+ * (0374) AK7371 rear camera Voice Coil Motor (VCM) autofocus on ISP I2C2 (gpc2-4/5, 7-bit addr 0x0C).
+ * 9-bit position 0..511 (INF -> MACRO), active mode 0x02 = 0x00, standby 0x02 = 0x40.
+ */
+static bool
+nc_ak7371_write8_pins(unsigned sda, unsigned scl, uint8_t reg, uint8_t val)
+{
+	uint32_t ob = NC_BANK;
+	unsigned osda = NC_SDA, oscl = NC_SCL;
+	NC_BANK = 0x140; NC_SDA = sda; NC_SCL = scl;
+	nc_start();
+	bool ok = nc_byte_out(0x18u) && nc_byte_out(reg) && nc_byte_out(val);
+	nc_stop();
+	NC_BANK = ob; NC_SDA = osda; NC_SCL = oscl;
+	return ok;
+}
+
+static bool
+nc_ak7371_set_focus(uint32_t pos10)
+{
+	if (!nc_af_ok) {
+		return false;
+	}
+	if (pos10 > 1023u) {
+		pos10 = 1023u;
+	}
+	uint32_t pos9 = pos10 >> 1; /* 0..511 (AK7371 9-bit INF->MAC) */
+	uint8_t hi = (uint8_t)((pos9 >> 1) & 0xffu);
+	uint8_t lo = (uint8_t)((pos9 & 1u) << 7);
+	bool ok = nc_ak7371_write8_pins(nc_af_sda, nc_af_scl, 0x00u, hi) &&
+	    nc_ak7371_write8_pins(nc_af_sda, nc_af_scl, 0x01u, lo);
+	if (ok) {
+		nc_focus = pos10;
+	}
+	return ok;
+}
+
+static void
+nc_ak7371_init(void)
+{
+	nc_af_ok = false;
+	nc_focus = 0xffffffffu;
+	/* Release gpc2-4/5 lines high (input with board pull-up) and probe both SDA/SCL orders */
+	uint32_t ob = NC_BANK;
+	unsigned osda = NC_SDA, oscl = NC_SCL;
+	NC_BANK = 0x140; NC_SDA = 4; NC_SCL = 5;
+	nc_line(4, 1);
+	nc_line(5, 1);
+	NC_BANK = ob; NC_SDA = osda; NC_SCL = oscl;
+	if (nc_ak7371_write8_pins(4, 5, 0x02u, 0x00u)) {
+		nc_af_sda = 4; nc_af_scl = 5; nc_af_ok = true;
+	} else if (nc_ak7371_write8_pins(5, 4, 0x02u, 0x00u)) {
+		nc_af_sda = 5; nc_af_scl = 4; nc_af_ok = true;
+	}
+	if (nc_af_ok) {
+		/* Samsung AK7371_DEFAULT_FIRST_POSITION = 120 (9-bit) -> 240 (10-bit) for far/hyperfocal start */
+		nc_ak7371_set_focus(240u);
+		printf("NOTEFE CAM: AK7371 AF ready on gpc2-%u/%u, pos=%u\n", nc_af_sda, nc_af_scl, nc_focus);
+	} else {
+		printf("NOTEFE CAM: AK7371 AF did not answer on gpc2-4/5\n");
+	}
+}
+
+static void
+nc_ak7371_off(void)
+{
+	if (nc_af_ok) {
+		(void)nc_ak7371_write8_pins(nc_af_sda, nc_af_scl, 0x02u, 0x40u); /* standby */
+		nc_af_ok = false;
+		nc_focus = 0xffffffffu;
+	}
+}
