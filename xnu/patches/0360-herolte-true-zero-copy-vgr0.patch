 bool
 notefe_zc_flip(uint64_t pa, uint32_t bpr, uint32_t w, uint32_t h)
 {
+	if (herozc_on < 0) {
+		uint32_t v = 0;
+		PE_parse_boot_argn("herozc", &v, sizeof(v));
+		herozc_on = v ? 1 : 0;
+	}
+	if (herozc_on == 1) {
+		static uint64_t hzc_flips;
+		if (pa == 0 || pa + (uint64_t)bpr * h > 0x100000000ull || (bpr & 3u) != 0 || bpr / 4u < w) {
+			return false;
+		}
+		uint32_t sp = bpr / 4u;
+		/* Lock-free steady-state VGR0 zero-copy flip (~5 us, zero Mali work, zero hg_mtx contention). */
+		if (__atomic_load_n(&hvg_state, __ATOMIC_ACQUIRE) == 1 && hvg_vgr != 0 &&
+		    w == hvg_w && h == hvg_h && sp == hvg_stride && !(hg_rd(hvg_vgr, 0x04) & (1u << 19))) {
+			if (hg_rd(hvg_vgr, 0xb74) != (uint32_t)pa) {
+				hg_wr(hvg_vgr, 0x74, (uint32_t)pa);
+				hg_wr(hvg_vgr, 0x1c, 1);
+				if (++hzc_flips <= 5 || hzc_flips % 2000 == 0) {
+					printf("HEROLTE ZC: flip %llu to %#llx (%ux%u stride %u) decon %#x vgr %#x\n",
+					    hzc_flips, pa, w, h, sp, hvg_decon ? hg_rd(hvg_decon, 0x48) : 0, hg_rd(hvg_vgr, 0x04));
+				}
+			}
+			return true;
+		}
+		/* Native 1440x2560 lock-free zero-copy flip on G1. */
+		if (w == HG_PANEL_W && h == HG_PANEL_H && bpr == HG_FB_STRIDE &&
+		    __atomic_load_n(&hfb_state, __ATOMIC_ACQUIRE) == 1 &&
+		    __atomic_load_n(&hvg_state, __ATOMIC_ACQUIRE) == 0 && hfb_g1 != 0 &&
+		    !(hg_rd(hfb_g1, 0x04) & (1u << 19))) {
+			if (hg_rd(hfb_g1, 0xb74) != (uint32_t)pa) {
+				hg_wr(hfb_g1, 0x74, (uint32_t)pa);
+				hg_wr(hfb_g1, 0x1c, 1);
+				if (++hzc_flips <= 5 || hzc_flips % 2000 == 0) {
+					printf("HEROLTE ZC: G1 flip %llu to %#llx (%ux%u) idma %#x\n",
+					    hzc_flips, pa, w, h, hg_rd(hfb_g1, 0x04));
+				}
+			}
+			return true;
+		}
+		lck_mtx_lock(hg_mtx);
+		if (hgp_state == 0) {
+			hgp_state = hgp_setup() ? 1 : -1;
+		}
+		if (hfb_state == 0 && hgp_state == 1) {
+			hfb_setup_locked();
+		}
+		if (hvg_state == 1 && hvg_vgr != 0 && (hg_rd(hvg_vgr, 0x04) & (1u << 19))) {
+			hg_wr(hvg_vgr, 0x04, 1u << 19);
+			hvg_leave("VGR0 ZC read error");
+			hvg_state = -1;
+		}
+		if (hvg_state == 1 && (w != hvg_w || h != hvg_h || sp != hvg_stride)) {
+			hvg_leave("ZC frame size changed");
+		}
+		bool zok = false;
+		if (w == HG_PANEL_W && h == HG_PANEL_H && bpr == HG_FB_STRIDE) {
+			if (hvg_state == 1) {
+				hvg_leave("native 1:1 ZC");
+			}
+			if (hfb_state == 1 && hfb_g1 != 0) {
+				hg_wr(hfb_g1, 0x74, (uint32_t)pa);
+				hg_wr(hfb_g1, 0x1c, 1);
+				hzc_flips++;
+				printf("HEROLTE ZC: active on G1 (%ux%u, pa %#llx)\n", w, h, pa);
+				zok = true;
+			}
+		} else if (hvg_state == 0 && hvg_wanted(w, h)) {
+			hvg_enter(pa, w, h, sp);
+			if (hvg_state == 1) {
+				hzc_flips++;
+				printf("HEROLTE ZC: active on VGR0 (%ux%u stride %u, pa %#llx)\n", w, h, sp, pa);
+				zok = true;
+			}
+		} else if (hvg_state == 1 && hvg_vgr != 0 && w == hvg_w && h == hvg_h && sp == hvg_stride) {
+			hg_wr(hvg_vgr, 0x74, (uint32_t)pa);
+			hg_wr(hvg_vgr, 0x1c, 1);
+			hzc_flips++;
+			zok = true;
+		}
+		lck_mtx_unlock(hg_mtx);
+		return zok;
+	}
 	if (zc_state < 0 || pa == 0 || pa + (uint64_t)bpr * h > 0x100000000ull) {
 		return false;
 	}
@@ -4746,7 +4834,8 @@ bool notefe_zc_active(void);
 bool
 notefe_zc_active(void)
 {
-	return zc_on_window;
+	return zc_on_window || (herozc_on == 1 && (__atomic_load_n(&hvg_state, __ATOMIC_ACQUIRE) == 1 ||
+	    __atomic_load_n(&hfb_state, __ATOMIC_ACQUIRE) == 1));
 }
 
