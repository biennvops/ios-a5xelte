 uint32_t herolte_gpu_submit_batch(const uint64_t *pairs, unsigned count, uint64_t *us);
+uint64_t herolte_gpu_enqueue(unsigned js, uint64_t jc, uint64_t *done_out, uint64_t *gpu_us_out);
+uint64_t herolte_gpu_wait_seq(uint64_t seq, bool nonblock, uint64_t *gpu_us_out);
 
 #define HG_PMU_PA       0x105c0000u
 #define HG_PMU_G3D_CONF 0x4060u
@@ -375,6 +377,20 @@ static uint32_t hg_last_js_status;
 static LCK_GRP_DECLARE(hg_grp, "herolte_gpu");
 static LCK_MTX_DECLARE(hg_mtx_store, &hg_grp);
 #define hg_mtx (&hg_mtx_store)
+static LCK_MTX_DECLARE(hg_q_mtx_store, &hg_grp);
+#define hg_q_mtx (&hg_q_mtx_store)
+
+/*
+ * Kernel GPU FIFO ring (0357): herolte_gpu_enqueue() appends (jc, js) and returns immediately (~10 us)
+ * while hg_worker_thread drains jobs in strict FIFO order on the Mali and bumps hg_q_done after EVERY
+ * individual job (so Mesa's BO cache immediately sees completed BOs). herolte_gpu_present_draw() waits
+ * for hg_q_done >= hg_q_tail on fWorkLoop so backboardd never stalls in glFinish() at frame_end().
+ */
+#define HG_Q_SIZE 256
+static struct { uint64_t jc; uint8_t js; } hg_q[HG_Q_SIZE];
+static uint64_t hg_q_tail, hg_q_done, hg_q_gpu_us;
+static bool hg_q_started;
+static int hg_q_work_ev, hg_q_done_ev;
 
 /*
  * Linux panfrost's quirks for a T880 r2p0 (panfrost_gpu_init_quirks): the
@@ -2433,6 +2449,10 @@ herolte_gpu_present_map(uint32_t id, const uint64_t *pages, unsigned n)
 bool
 herolte_gpu_present_draw(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h)
 {
+	/* Drain all client GPU jobs queued up to this swap (e.g. glBlitFramebuffer) on fWorkLoop. */
+	if (__atomic_load_n(&hg_q_started, __ATOMIC_ACQUIRE)) {
+		(void)herolte_gpu_wait_seq(0, false, NULL);
+	}
 	/* Wait for the previous VGR0/G1 flip to latch WITHOUT holding hg_mtx so backboardd can keep submitting. */
 	hfb_wait_unlocked();
 	lck_mtx_lock(hg_mtx);
@@ -2673,6 +2693,100 @@ herolte_gpu_submit_batch(const uint64_t *pairs, unsigned count, uint64_t *us)
 	return status;
 }
 
+static void
+hg_worker_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	lck_mtx_lock(hg_q_mtx);
+	for (;;) {
+		while (hg_q_done == hg_q_tail) {
+			(void)lck_mtx_sleep(hg_q_mtx, LCK_SLEEP_DEFAULT, (event_t)&hg_q_work_ev, THREAD_UNINT);
+		}
+		uint64_t jc = hg_q[hg_q_done % HG_Q_SIZE].jc;
+		unsigned js = hg_q[hg_q_done % HG_Q_SIZE].js;
+		lck_mtx_unlock(hg_q_mtx);
+
+		uint64_t dt = 0;
+		lck_mtx_lock(hg_mtx);
+		if (hg_up_state == 1 && jc != 0) {
+			uint64_t start = mach_absolute_time();
+			hg_affinity = hg_rd(hg_gpu, SHADER_PRESENT_LO);
+			hg_job_va = jc;
+			hg_job_cpu = 0;
+			hg_run_quiet = true;
+			hg_run_nap = true;
+			(void)hg_run(js, js ? "HEROGPU fifo JS1" : "HEROGPU fifo JS0");
+			hg_run_nap = false;
+			hg_run_quiet = false;
+			hg_job_va = HG_TEST_VA;
+			hg_affinity = 1;
+			dt = hg_us_since(start);
+		}
+		lck_mtx_unlock(hg_mtx);
+
+		lck_mtx_lock(hg_q_mtx);
+		hg_q_done++;
+		hg_q_gpu_us += dt;
+		thread_wakeup((event_t)&hg_q_done_ev);
+	}
+}
+
+uint64_t
+herolte_gpu_enqueue(unsigned js, uint64_t jc, uint64_t *done_out, uint64_t *gpu_us_out)
+{
+	if (js > 1 || jc == 0) {
+		return 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	lck_mtx_lock(hg_q_mtx);
+	if (!hg_q_started) {
+		thread_t th = THREAD_NULL;
+		if (kernel_thread_start(hg_worker_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+			__atomic_store_n(&hg_q_started, true, __ATOMIC_RELEASE);
+			printf("HEROLTE GPU: kernel FIFO worker started (%u slots)\n", HG_Q_SIZE);
+		} else {
+			lck_mtx_unlock(hg_q_mtx);
+			return 0;
+		}
+	}
+	while (hg_q_tail - hg_q_done >= HG_Q_SIZE) {
+		(void)lck_mtx_sleep(hg_q_mtx, LCK_SLEEP_DEFAULT, (event_t)&hg_q_done_ev, THREAD_UNINT);
+	}
+	hg_q[hg_q_tail % HG_Q_SIZE].jc = jc;
+	hg_q[hg_q_tail % HG_Q_SIZE].js = (uint8_t)js;
+	uint64_t seq = ++hg_q_tail;
+	uint64_t done = hg_q_done;
+	uint64_t tus = hg_q_gpu_us;
+	thread_wakeup((event_t)&hg_q_work_ev);
+	lck_mtx_unlock(hg_q_mtx);
+	if (done_out) {
+		*done_out = done;
+	}
+	if (gpu_us_out) {
+		*gpu_us_out = tus;
+	}
+	return seq;
+}
+
+uint64_t
+herolte_gpu_wait_seq(uint64_t seq, bool nonblock, uint64_t *gpu_us_out)
+{
+	lck_mtx_lock(hg_q_mtx);
+	uint64_t target = seq == 0 ? hg_q_tail : seq;
+	if (!nonblock) {
+		while (hg_q_done < target) {
+			(void)lck_mtx_sleep(hg_q_mtx, LCK_SLEEP_DEFAULT, (event_t)&hg_q_done_ev, THREAD_UNINT);
+		}
+	}
+	uint64_t done = hg_q_done;
+	uint64_t tus = hg_q_gpu_us;
+	lck_mtx_unlock(hg_q_mtx);
+	if (gpu_us_out) {
+		*gpu_us_out = tus;
+	}
+	return done;
+}
