+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+void
+AppleCLCD::presentThread(void *arg, __unused wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)arg;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return;
+	}
+	for (;;) {
+		IOLockLock(fb->fLock);
+		while (!fb->fDirty || fb->fPowerOff) {
+			IOLockSleep(fb->fLock, &fb->fDirty, THREAD_UNINT);
+		}
+		uint64_t now = mach_absolute_time();
+		if (now < sweet_fb_hold_until) {
+			IOLockUnlock(fb->fLock);
+			IOSleep(2);
+			continue;
+		}
+		memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		uint64_t seq = fb->fPendingSeq;
+		uint64_t gpu_seq = fb->fPendingGpuSeq;
+		fb->fDirty = false;
+		IOLockUnlock(fb->fLock);
+
+		uint64_t before = mach_absolute_time();
+		herolte_gpu_wait_present(gpu_seq);
+		uint64_t bytes = fb->present(rec);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - before, &ns);
+
+		IOLockLock(fb->fLock);
+		uint64_t vc = __atomic_load_n(&fb->fVsyncCount, __ATOMIC_ACQUIRE);
+		uint64_t gap = vc - fb->fLastShown;
+		fb->fGaps[gap <= 1 ? 0 : gap >= 4 ? 3 : gap - 1] += gap <= 30 ? 1 : 0;
+		fb->fLastShown = vc;
+		fb->fShownSeq = seq;
+		fb->fPerfFrames++;
+		fb->fPerfBytes += bytes;
+		fb->fPerfNS += ns;
+		if (ns > fb->fPerfMaxNS) {
+			fb->fPerfMaxNS = ns;
+		}
+		IOLockWakeup(fb->fLock, &fb->fShownSeq, false);
+		IOLockUnlock(fb->fLock);
+	}
+}
+#endif
