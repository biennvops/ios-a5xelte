+/*
+ * (0378) Run JS0(k) (fragment) and JS1(k+1) (vertex/tiler of next batch) concurrently on Mali-T880's
+ * two independent hardware job slots. Called with hg_mtx held and hg_up_state == 1.
+ */
+static void
+hg_run_pair(uint64_t jc0, uint64_t jc1)
+{
+	uint32_t aff = hg_shader_mask ? hg_shader_mask : hg_rd(hg_gpu, SHADER_PRESENT_LO);
+	if (!hg_as_ok) {
+		hg_affinity = aff;
+		hg_job_va = jc0;
+		hg_job_cpu = 0;
+		hg_run_quiet = true;
+		hg_run_nap = true;
+		(void)hg_run(0, "HEROGPU fifo JS0");
+		hg_job_va = jc1;
+		(void)hg_run(1, "HEROGPU fifo JS1");
+		hg_run_nap = false;
+		hg_run_quiet = false;
+		hg_job_va = HG_TEST_VA;
+		hg_affinity = 1;
+		return;
+	}
+	hgu_flush_if_dirty_locked();
+	hg_wr(hg_gpu, MMU_IRQ_CLEAR, 0xffffffffu);
+	hg_wr(hg_gpu, JOB_IRQ_CLEAR, 0xffffffffu);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint32_t flush_start = (hg_flush_mode >= 1) ? 0 : (3u << 8);
+	uint32_t flush_red = (hg_flush_mode >= 3) ? (1u << 14) : 0;
+	uint32_t flush_id = flush_red ? hg_rd(hg_gpu, 0x38) : 0;
+	uint32_t cfg0 = (8u << 16) | flush_start | (3u << 12) | flush_red;
+	uint32_t cfg1 = (8u << 16) | flush_start | ((hg_flush_mode >= 3) ? (1u << 12) : (3u << 12)) | flush_red;
+
+	uint32_t s0 = JS_BASE(0), s1 = JS_BASE(1);
+	hg_wr(hg_gpu, s0 + 0x40, (uint32_t)jc0);
+	hg_wr(hg_gpu, s0 + 0x44, (uint32_t)(jc0 >> 32));
+	hg_wr(hg_gpu, s0 + 0x50, aff);
+	hg_wr(hg_gpu, s0 + 0x54, 0);
+	if (flush_red) { hg_wr(hg_gpu, s0 + 0x70, flush_id); }
+	hg_wr(hg_gpu, s0 + 0x58, cfg0);
+
+	hg_wr(hg_gpu, s1 + 0x40, (uint32_t)jc1);
+	hg_wr(hg_gpu, s1 + 0x44, (uint32_t)(jc1 >> 32));
+	hg_wr(hg_gpu, s1 + 0x50, aff);
+	hg_wr(hg_gpu, s1 + 0x54, 0);
+	if (flush_red) { hg_wr(hg_gpu, s1 + 0x70, flush_id); }
+	hg_wr(hg_gpu, s1 + 0x58, cfg1);
+
+	/* Kick both hardware slots together! */
+	hg_wr(hg_gpu, s0 + 0x60, 1);
+	hg_wr(hg_gpu, s1 + 0x60, 1);
+
+	uint32_t jirq = 0, mirq = 0, girq = 0;
+	unsigned waited_us = 0;
+	const uint32_t done_both = (1u << 0) | (1u << 1);
+	const uint32_t fail_any = (1u << 16) | (1u << 17);
+	while (waited_us < 200000) {
+		jirq = hg_rd(hg_gpu, JOB_IRQ_RAWSTAT);
+		if (((jirq & done_both) == done_both) || (jirq & fail_any)) {
+			break;
+		}
+		if (waited_us >= 500 && hg_sleep_us >= 10 && hg_sleep_us <= 5000) {
+			mirq = hg_rd(hg_gpu, MMU_IRQ_RAWSTAT);
+			girq = hg_rd(hg_gpu, GPU_IRQ_RAWSTAT);
+			if (mirq || (girq & 0x81)) {
+				break;
+			}
+			hg_usleep(hg_sleep_us);
+			waited_us += hg_sleep_us;
+		} else {
+			delay(1);
+			waited_us += 1;
+		}
+	}
+	if ((jirq & done_both) != done_both || (jirq & fail_any)) {
+		mirq = hg_rd(hg_gpu, MMU_IRQ_RAWSTAT);
+		girq = hg_rd(hg_gpu, GPU_IRQ_RAWSTAT);
+		printf("HEROLTE GPU: pair fault jirq=%#x mirq=%#x girq=%#x st0=%#x st1=%#x\n",
+		    jirq, mirq, girq, hg_rd(hg_gpu, s0 + 0x24), hg_rd(hg_gpu, s1 + 0x24));
+		hg_recover("HEROGPU pair");
+	}
+	hg_wr(hg_gpu, JOB_IRQ_CLEAR, jirq);
+}
