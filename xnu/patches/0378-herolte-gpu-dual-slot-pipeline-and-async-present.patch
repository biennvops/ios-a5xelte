+					hg_job_va = jc;
+					hg_job_cpu = 0;
+					hg_run_quiet = true;
+					hg_run_nap = true;
+					(void)hg_run(js, js ? "HEROGPU fifo JS1" : "HEROGPU fifo JS0");
+					hg_run_nap = false;
