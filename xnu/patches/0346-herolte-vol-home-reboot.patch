diff --git a/bsd/dev/a5xelte_keys.c b/bsd/dev/a5xelte_keys.c
--- a/bsd/dev/a5xelte_keys.c
+++ b/bsd/dev/a5xelte_keys.c
@@ -109,6 +109,23 @@ a5_keys_thread(void *arg, wait_result_t result)
 				}
 			}
 			stable = sample;
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+			/* Vol+ (GPA0-3) and Home (GPA0-5) held together: reboot to TWRP recovery. */
+			if (!(sample & (1u << a5_key_pins[1])) &&
+			    !(sample & (1u << a5_key_pins[3]))) {
+				vm_offset_t pmu = ml_io_map(0x105c0000u, 0x1000u);
+				if (pmu) {
+					*(volatile uint32_t *)(pmu + 0x808u) = 0x12345678u;
+					*(volatile uint32_t *)(pmu + 0x80cu) = 0x12345674u;
+					__asm__ volatile("dsb sy" ::: "memory");
+					*(volatile uint32_t *)(pmu + 0x400u) = 1u;
+					__asm__ volatile("dsb sy" ::: "memory");
+				}
+				for (;;) {
+					__asm__ volatile("wfe");
+				}
+			}
+#endif
 		}
 		a5_keys_wait();
 	}
