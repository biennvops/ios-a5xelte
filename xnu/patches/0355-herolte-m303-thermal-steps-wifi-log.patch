+struct hc_rate {
+	uint32_t mhz, m;
+	uint8_t volt, promise;
+};
+static struct hc_rate hc_full, hc_warm = { 1976, 228, 0x62, 5 };
+
+static bool
+hc_go(int want, int *have)
+{
+	if (want == *have) {
+		return true;
+	}
+	if (want == 2) {
+		bool ok = hc_go_low();
+		*have = hc.high ? *have : 2;
+		return ok;
+	}
+	const struct hc_rate *r = (want == 1 && hc_full.mhz > hc_warm.mhz) ? &hc_warm : &hc_full;
+	if (hc.high && !hc_go_low()) {
+		return false;
+	}
+	*have = 2;
+	hc.mhz = r->mhz;
+	hc.m = r->m;
+	hc.volt = r->volt;
+	hc.promise = r->promise;
+	if (!hc_go_high()) {
+		return false;
+	}
+	*have = want;
+	return true;
+}
