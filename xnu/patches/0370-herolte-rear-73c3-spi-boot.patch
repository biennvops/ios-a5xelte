+/*
+ * (0370) Bit-banged SPI Mode 0 on gpc3 (0x136d0160) for Samsung S5C73C3 companion ISP:
+ *   gpc3-4 = CLK, gpc3-5 = SS_N (active low), gpc3-6 = MISO (in), gpc3-7 = MOSI (out).
+ */
+#define NC_SPI_BANK 0x160u
+#define NC_SPI_CLK  (1u << 4)
+#define NC_SPI_CSN  (1u << 5)
+#define NC_SPI_MISO (1u << 6)
+#define NC_SPI_MOSI (1u << 7)
+
+static void
+nc_spi_init(vm_offset_t pins)
+{
+	nc_pin(pins, NC_SPI_BANK, 4, 1, 0, 0); /* CLK out, low */
+	nc_pin(pins, NC_SPI_BANK, 5, 1, 0, 1); /* SS_N out, high */
+	nc_pin(pins, NC_SPI_BANK, 6, 0, 0, -1); /* MISO in */
+	nc_pin(pins, NC_SPI_BANK, 7, 1, 0, 0); /* MOSI out, low */
+}
+
+static void
+nc_spi_deinit(vm_offset_t pins)
+{
+	nc_pin(pins, NC_SPI_BANK, 5, 1, 0, 1);
+	nc_pin(pins, NC_SPI_BANK, 4, 1, 0, 0);
+	nc_pin(pins, NC_SPI_BANK, 7, 1, 0, 0);
+}
+
+static inline void
+nc_spi_tx_byte(vm_offset_t pins, uint32_t base_dat, uint8_t b)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		uint32_t d = base_dat | ((b & (1u << bit)) ? NC_SPI_MOSI : 0u);
+		notefe_wr(pins, NC_SPI_BANK + 4, d);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		notefe_wr(pins, NC_SPI_BANK + 4, d | NC_SPI_CLK);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	notefe_wr(pins, NC_SPI_BANK + 4, base_dat);
+}
+
+static inline uint8_t
+nc_spi_rx_byte(vm_offset_t pins, uint32_t base_dat)
+{
+	uint8_t v = 0;
+	for (int bit = 7; bit >= 0; bit--) {
+		notefe_wr(pins, NC_SPI_BANK + 4, base_dat);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		notefe_wr(pins, NC_SPI_BANK + 4, base_dat | NC_SPI_CLK);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (notefe_rd(pins, NC_SPI_BANK + 4) & NC_SPI_MISO) {
+			v |= (uint8_t)(1u << bit);
+		}
+	}
+	notefe_wr(pins, NC_SPI_BANK + 4, base_dat);
+	return v;
+}
+
+static void
+nc_c3_spi_write16(vm_offset_t pins, uint16_t addr, uint16_t data)
+{
+	uint32_t dat = notefe_rd(pins, NC_SPI_BANK + 4) & ~(NC_SPI_CLK | NC_SPI_CSN | NC_SPI_MOSI);
+	notefe_wr(pins, NC_SPI_BANK + 4, dat);
+	nc_spi_tx_byte(pins, dat, 0x02);
+	nc_spi_tx_byte(pins, dat, (uint8_t)(addr >> 8));
+	nc_spi_tx_byte(pins, dat, (uint8_t)(addr & 0xff));
+	nc_spi_tx_byte(pins, dat, (uint8_t)(data >> 8));
+	nc_spi_tx_byte(pins, dat, (uint8_t)(data & 0xff));
+	notefe_wr(pins, NC_SPI_BANK + 4, dat | NC_SPI_CSN);
+	delay(1);
+}
+
+static uint16_t
+nc_c3_spi_read16(vm_offset_t pins, uint16_t addr)
+{
+	uint32_t dat = notefe_rd(pins, NC_SPI_BANK + 4) & ~(NC_SPI_CLK | NC_SPI_CSN | NC_SPI_MOSI);
+	notefe_wr(pins, NC_SPI_BANK + 4, dat);
+	nc_spi_tx_byte(pins, dat, 0x03);
+	nc_spi_tx_byte(pins, dat, (uint8_t)(addr >> 8));
+	nc_spi_tx_byte(pins, dat, (uint8_t)(addr & 0xff));
+	nc_spi_tx_byte(pins, dat, 0xff);
+	uint8_t hi = nc_spi_rx_byte(pins, dat);
+	uint8_t lo = nc_spi_rx_byte(pins, dat);
+	notefe_wr(pins, NC_SPI_BANK + 4, dat | NC_SPI_CSN);
+	delay(1);
+	return (uint16_t)((hi << 8) | lo);
+}
+
+static void
+nc_c3_spi_burst(vm_offset_t pins, const uint8_t *buf, uint32_t len)
+{
+	uint32_t dat = notefe_rd(pins, NC_SPI_BANK + 4) & ~(NC_SPI_CLK | NC_SPI_CSN | NC_SPI_MOSI);
+	const uint32_t bw = 253u; /* exact fimc_is_comp_spi_burst_write(256, LITTLE_ENDIAN) chunk size */
+	for (uint32_t off = 0; off < len; off += bw) {
+		uint32_t n = (off + bw <= len) ? bw : (len - off);
+		notefe_wr(pins, NC_SPI_BANK + 4, dat);
+		nc_spi_tx_byte(pins, dat, 0x02);
+		nc_spi_tx_byte(pins, dat, 0x6f);
+		nc_spi_tx_byte(pins, dat, 0x12);
+		for (uint32_t j = 0; j < n; j++) {
+			nc_spi_tx_byte(pins, dat, buf[off + j]);
+		}
+		notefe_wr(pins, NC_SPI_BANK + 4, dat | NC_SPI_CSN);
+	}
+}
+
+static uint16_t
+nc_c3_i2c_read16(uint16_t reg)
+{
+	uint8_t b[2] = { 0, 0 };
+	(void)nc_sensor_read(0x3d, reg, b, 2);
+	return (uint16_t)((b[0] << 8) | b[1]);
+}
+
+/* Upload 73C3 firmware over SPI, boot ARM, configure mode & start 73C3 MIPI output. */
+static bool
+nc_c3_load_and_start(vm_offset_t pins, uint16_t *spi_id_out, uint16_t *ver_out, uint16_t *init_out)
+{
+	nc_spi_init(pins);
+	uint16_t sid = nc_c3_spi_read16(pins, 0x0000);
+	if (spi_id_out) { *spi_id_out = sid; }
+	if (!nc_c3_fw_buf || nc_c3_fw_len < 1024) {
+		nc_spi_deinit(pins);
+		return false;
+	}
+	/* fimc_is_comp_loadfirm() exact sequence */
+	nc_c3_spi_write16(pins, 0x0008, 0x0001);
+	delay(1000);
+	nc_c3_spi_write16(pins, 0x6428, 0x0008);
+	nc_c3_spi_write16(pins, 0x642a, 0x0000);
+	nc_c3_spi_burst(pins, nc_c3_fw_buf, nc_c3_fw_len);
+	nc_c3_spi_write16(pins, 0x6048, 0x0001); /* ARM Reset & Memory Remap */
+	nc_c3_spi_write16(pins, 0x6014, 0x0001); /* ARM Go */
+	ns_sleep_ms(10);
+
+	uint16_t ver = nc_c3_i2c_read16(0x0002);
+	uint16_t initd = nc_c3_i2c_read16(0x0008);
+	if (ver_out) { *ver_out = ver; }
+	if (init_out) { *init_out = initd; }
+
+	/* Master & Mode setfile (companion_imx260_{master,mode}_setfile.bin) + ModeChange(idx=7) + StreamEnable */
+	nc_c3_spi_write16(pins, 0x0008, 0x0000); /* using M2M cal = 0 */
+	nc_c3_spi_write16(pins, 0x6800, 0x0000);
+	nc_c3_spi_write16(pins, 0x0008, 0x0001);
+	delay(1000);
+	nc_sensor_write(0x3d, 0x0042, (uint16_t)nc_o_rear_c3idx, 16); /* api_config_idx (7 = 2016x1512) */
+	nc_sensor_write(0x3d, 0x0990, 0x0000, 16);                   /* api_otf_WdrMode = off */
+	nc_sensor_write(0x3d, 0x0992, 0x0000, 16);                   /* api_otf_PowerMode = normal */
+	nc_sensor_write(0x3d, 0x09c6, 0x0001, 16);                   /* api_pafstat_bBypass = 1 */
+	nc_sensor_write(0x3d, 0x0a10, 0x0001, 16);                   /* api_cafstat_bBypass = 1 */
+	if (nc_o_rear_bypass) {
+		nc_sensor_write(0x3d, 0x003a, 0x0099, 16);           /* api_debug_out = Bypass ON */
+	}
+	nc_sensor_write(0x3d, 0x6802, 0x0001, 16);                   /* HOST_INTRP_ChangeConfig */
+	delay(2000);
+	nc_sensor_write(0x3d, 0x6800, 0x0001, 16);                   /* HOST_INTRP_StreamEnable */
+	delay(1000);
+	nc_spi_deinit(pins);
+	return true;
+}
