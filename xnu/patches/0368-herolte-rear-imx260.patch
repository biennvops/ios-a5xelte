+static void
+nc_csis0_setup_4lane(vm_offset_t csis, uint32_t settle, uint32_t w, uint32_t h)
+{
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) & ~1u);
+	notefe_wr(csis, 0x24, notefe_rd(csis, 0x24) & ~1u);
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | 2u);
+	for (unsigned n = 0; n < 100 && (notefe_rd(csis, 0x4) & 2u); n++) {
+		delay(10);
+	}
+	for (unsigned vc = 0; vc < 4; vc++) {
+		notefe_wr(csis, 0x1000 + vc * 0x100, (notefe_rd(csis, 0x1000 + vc * 0x100) | 1u) & ~2u);
+	}
+	notefe_wr(csis, 0x24, (notefe_rd(csis, 0x24) & ~(0xffu << 24) & ~(0xfu << 1)) | ((settle & 0xffu) << 24) | (0xfu << 1));
+	notefe_wr(csis, 0x4, (notefe_rd(csis, 0x4) & ~(3u << 8) & ~(1u << 12) & ~(3u << 10)) | (3u << 8));
+	notefe_wr(csis, 0x40, (notefe_rd(csis, 0x40) & ~0x1fffu) | (0x2bu << 2) | (1u << 12));
+	notefe_wr(csis, 0x44, (h << 16) | w);
+	notefe_wr(csis, 0x1004, notefe_rd(csis, 0x1004) & ~(3u << 14));
+	for (uint32_t a = 0x1010; a <= 0x102c; a += 4) {
+		notefe_wr(csis, a, NC_BUF);
+	}
+	notefe_wr(csis, 0x1000, (notefe_rd(csis, 0x1000) & ~1u) | 2u);
+	notefe_wr(csis, 0x14, notefe_rd(csis, 0x14));
+	notefe_wr(csis, 0x1c, notefe_rd(csis, 0x1c));
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | (0xfu << 16));
+	notefe_wr(csis, 0x24, notefe_rd(csis, 0x24) | 1u);
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | 1u);
+}
+
+static unsigned
+nc_imx260_write_init(void)
+{
+	unsigned bad = 0;
+	bad += !nc_sensor_write(0x1a, 0x0100, 0x00, 8);
+	for (unsigned i = 0; i < sizeof(nc_imx260_global) / sizeof(nc_imx260_global[0]); i++) {
+		bad += !nc_sensor_write(0x1a, nc_imx260_global[i].reg, nc_imx260_global[i].val, 8);
+	}
+	for (unsigned i = 0; i < sizeof(nc_imx260_2016) / sizeof(nc_imx260_2016[0]); i++) {
+		bad += !nc_sensor_write(0x1a, nc_imx260_2016[i].reg, nc_imx260_2016[i].val, 8);
+	}
+	bad += !nc_sensor_write(0x1a, 0x0101, (uint16_t)(nc_o_rear_flip & 3u), 8);
+	bad += !nc_sensor_write(0x1a, 0x0202, 0x0300, 16);
+	bad += !nc_sensor_write(0x1a, 0x0204, 0x0100, 16);
+	return bad;
+}
