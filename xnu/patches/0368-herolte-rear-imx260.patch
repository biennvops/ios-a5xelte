+static void
+notefe_cam_rear_frame(vm_offset_t pins)
+{
+	static vm_offset_t top, csis0, phy0, pmu, mmu0, cam0;
+	if (!top) {
+		top = ml_io_map(0x10570000u, 0x1000);
+		csis0 = ml_io_map(0x14000000u, 0x2000);
+		phy0 = ml_io_map(0x144f1000u, 0x1000);
+		pmu = ml_io_map(0x105c0000u, 0x1000);
+		mmu0 = ml_io_map(0x140e0000u, 0x1000);
+		cam0 = ml_io_map(0x144d0000u, 0x1000);
+	}
+	if (!nc_frame_c) {
+		nc_frame_c = notefe_physmap_cached(NC_BUF, NC_MAP_LEN);
+	}
+	if (!top || !csis0 || !phy0 || !pmu || !mmu0 || !cam0 || !nc_frame_c) {
+		snprintf(nc_rear_info, sizeof(nc_rear_info), "rear frame: map failed");
+		return;
+	}
+	nc_pins = pins;
+	uint32_t gcon = notefe_rd(pins, 0x40);
+	if (((gcon >> 16) & 0xf) != 2 || ((gcon >> 20) & 0xf) != 2) {
+		nc_pin(pins, 0x40, 4, 2, -1, -1);
+		nc_pin(pins, 0x40, 5, 2, -1, -1);
+	}
+	nc_bus_init();
+	uint8_t l3 = 0, l7 = 0, l10 = 0, l11 = 0, l12 = 0;
+	if (!nc_read(0x59, 0x20, &l3, 1) || !nc_read(0x59, 0x24, &l7, 1) ||
+	    !nc_read(0x59, 0x27, &l10, 1) || !nc_read(0x59, 0x28, &l11, 1) ||
+	    !nc_read(0x59, 0x29, &l12, 1)) {
+		snprintf(nc_rear_info, sizeof(nc_rear_info), "rear frame: S2MPB02 fail");
+		return;
+	}
+	memset((void *)nc_frame_c, 0xa5, 65536);
+	flush_dcache(nc_frame_c, 65536, 0);
+
+	nc_pin(pins, 0x120, 0, 1, 0, 0);
+	nc_pin(pins, 0x120, 2, 1, 0, 0);
+	NC_BANK = 0x140; NC_SDA = 0; NC_SCL = 1;
+	nc_line(NC_SDA, 1);
+	nc_line(NC_SCL, 1);
+	nc_pmic_write(0x29, 0x80 | 0x58);
+	delay(2000);
+	nc_pmic_write(0x28, 0x80 | 0x18);
+	delay(200);
+	nc_pmic_write(0x28, 0x80 | 0x5b);
+	nc_pmic_write(0x27, 0x80 | 0x33);
+	nc_pmic_write(0x20, 0x80 | 0x24);
+	nc_pmic_write(0x24, 0x80 | 0x30);
+	delay(2000);
+	uint32_t mux = notefe_rd(top, 0xb00), div = notefe_rd(top, 0xb04);
+	notefe_wr(top, 0xb00, mux & ~(7u << 12));
+	for (unsigned n = 0; n < 1000 && ((notefe_rd(top, 0xb08) >> 12) & 7) != 0; n++) { delay(1); }
+	notefe_wr(top, 0xb04, div & ~0xffu);
+	nc_pin(pins, 0x180, 0, 2, -1, -1);
+	delay(2000);
+	nc_pin(pins, 0x120, 0, 1, 0, 1);
+	delay(10000);
+
+	unsigned bad = nc_imx260_write_init();
+	uint32_t mmu_s = notefe_rd(mmu0, 0);
+	uint32_t iso_s = notefe_rd(pmu, 0x70c);
+	uint32_t phy_s = notefe_rd(phy0, 0x40);
+	uint32_t rx_m[4], rx_g[4];
+	notefe_wr(mmu0, 0, 0);
+	notefe_wr(pmu, 0x70c, iso_s | 1u);
+	notefe_wr(phy0, 0x40, phy_s & ~2u);
+	delay(10);
+	notefe_wr(phy0, 0x40, phy_s | 2u);
+	for (unsigned n = 0; n < 4; n++) {
+		rx_m[n] = notefe_rd(cam0, 0x220 + 4 * n);
+		rx_g[n] = notefe_rd(cam0, 0x848 + 4 * n);
+		notefe_wr(cam0, 0x220 + 4 * n, rx_m[n] | (1u << 12));
+		notefe_wr(cam0, 0x848 + 4 * n, rx_g[n] | 1u);
+	}
+	nc_csis0_setup_4lane(csis0, nc_o_rear_settle, NC_REAR_W, NC_REAR_H);
+	uint32_t f0 = notefe_rd(csis0, 0x100);
+	bad += !nc_sensor_write(0x1a, 0x0100, 0x01, 8);
+	ns_sleep_ms(600);
+	uint8_t sfc = 0, smode = 0;
+	(void)nc_sensor_read(0x1a, 0x0005, &sfc, 1);
+	(void)nc_sensor_read(0x1a, 0x0100, &smode, 1);
+	uint32_t f1 = notefe_rd(csis0, 0x100);
+	uint32_t dphy = notefe_rd(csis0, 0x28);
+	uint32_t irq0 = notefe_rd(csis0, 0x14), irq1 = notefe_rd(csis0, 0x1c);
+	uint32_t act = notefe_rd(csis0, 0x1030);
+	flush_dcache(nc_frame_c, 65536, 0);
+	unsigned changed = 0;
+	const uint8_t *bp = (const uint8_t *)nc_frame_c;
+	for (unsigned i = 0; i < 65536; i++) {
+		if (bp[i] != 0xa5) { changed++; }
+	}
+
+	(void)nc_sensor_write(0x1a, 0x0100, 0x00, 8);
+	delay(30000);
+	notefe_wr(csis0, 0x1000, notefe_rd(csis0, 0x1000) | 1u);
+	notefe_wr(csis0, 0x4, notefe_rd(csis0, 0x4) & ~1u);
+	notefe_wr(csis0, 0x24, notefe_rd(csis0, 0x24) & ~1u);
+	notefe_wr(csis0, 0x4, notefe_rd(csis0, 0x4) | 2u);
+	for (unsigned n = 0; n < 4; n++) {
+		notefe_wr(cam0, 0x220 + 4 * n, rx_m[n]);
+		notefe_wr(cam0, 0x848 + 4 * n, rx_g[n]);
+	}
+	notefe_wr(phy0, 0x40, phy_s);
+	notefe_wr(pmu, 0x70c, iso_s);
+	notefe_wr(mmu0, 0, mmu_s);
+	nc_pin(pins, 0x120, 0, 1, 0, 0);
+	nc_pin(pins, 0x180, 0, 0, -1, -1);
+	notefe_wr(top, 0xb04, div);
+	notefe_wr(top, 0xb00, mux);
+	nc_pmic_write(0x29, l12 & 0x7f);
+	nc_pmic_write(0x24, l7 & 0x7f);
+	nc_pmic_write(0x20, l3 & 0x7f);
+	nc_pmic_write(0x27, l10 & 0x7f);
+	nc_pmic_write(0x28, l11 & 0x7f);
+	NC_SDA = 2; NC_SCL = 3;
+
+	snprintf(nc_rear_info, sizeof(nc_rear_info),
+	    "imx260 2016x1512: bad=%u mode=%#x sfc=%u csis0_f=%u->%u dphy=%#x irq=%#x/%#x act=%#x chg=%u/65536",
+	    bad, smode, sfc, f0, f1, dphy, irq0, irq1, act, changed);
+	printf("NOTEFE CAM: rear frame: %s\n", nc_rear_info);
+}
