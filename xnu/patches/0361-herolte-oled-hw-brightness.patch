diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 2256b31..be0297b 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2227,6 +2227,8 @@ hvg_leave(const char *why)
  */
 /* Note FE (0419): the panel's brightness, 255 = as drawn. Set by kern.notefe_brightness and the backlight service. */
 static volatile uint32_t notefe_bright_level = 255;
+static volatile bool hg_hwbl_active;
+static int hg_bright_ev;
 static bool zc_on_window;                /* (0425, below) */
 static void zc_window_locked(void);
 
@@ -2256,6 +2258,7 @@ notefe_brightness_set(uint32_t level, const char *why)
 		printf("NOTEFE BRIGHT: %u -> %u (%s)\n", notefe_bright_level, level, why);
 	}
 	notefe_bright_level = level;
+	thread_wakeup((event_t)&hg_bright_ev);
 	/* (0428) no window alpha: a dimmed frame goes through the copy (the next present switches back to G1) */
 }
 
@@ -2363,7 +2366,7 @@ hgp_draw_locked(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h)
 	/* Note FE (0419): brightness. Blend A + B * C with A = 0, B = source and C = the blend constant (level / 255),
 	 * instead of C = 1 - 0; alpha and the colour mask as before. 255: the copy exactly as before. */
 	{
-		uint32_t level = notefe_bright_level;
+		uint32_t level = hg_hwbl_active ? 255u : notefe_bright_level;
 		union { float f; uint32_t u; } k = { .f = (float)level / 255.0f };
 		hg_wr32(scr, S_RSD + 72, level >= 255 ? 0xf0921921u : 0xf0921721u);
 		hg_wr32(scr, S_RSD + 76, k.u);
@@ -4176,6 +4179,96 @@ hg_dsim_dcs_long(vm_offset_t dsim, const uint8_t *data, unsigned len)
 	return false;
 }
 
+static bool
+hg_dsim_dcs_short_param(vm_offset_t dsim, uint8_t reg, uint8_t val)
+{
+	hg_wr(dsim, 0x34, (1u << 28)); /* clear SFR_PH_FIFO_EMPTY */
+	hg_wr(dsim, 0x3c, 0x15u | ((uint32_t)reg << 8) | ((uint32_t)val << 16)); /* DCS short write 1 param */
+	for (unsigned t = 0; t < 5000; t++) {
+		if (hg_rd(dsim, 0x34) & (1u << 28)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/*
+ * (0361) Hardware OLED brightness on Samsung s6e3hf4_wqhd (hero2lte) via MIPI DSI AOR (0xB1) +
+ * GAMMA_UPDATE (0xF7 0x03/0x00) during masked V-blank. Works seamlessly under true zero-copy VGR0
+ * and lowers actual AMOLED emission power & heat. Boot-arg herohwbl=0 disables it.
+ */
+static void
+hg_bright_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	vm_offset_t decon = ml_io_map(0x13960000u, 0x1000);
+	vm_offset_t dsim = ml_io_map(0x13900000u, 0x1000);
+	if (!decon || !dsim) {
+		return;
+	}
+	bool dsc = (hg_rd(decon, 0x230) & 0x11u) == 0x11u;
+	uint32_t on = dsc ? 1u : 0u;
+	PE_parse_boot_argn("herohwbl", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	hg_hwbl_active = true;
+	printf("HEROLTE HWBL: hardware OLED AOR brightness active (%s)\n", dsc ? "s6e3hf4" : "generic");
+	uint32_t applied = 255u, logged = 0;
+	for (;;) {
+		uint32_t want = notefe_bright_level;
+		if (want == applied) {
+			uint64_t deadline;
+			clock_interval_to_deadline(250, kMillisecondScale, &deadline);
+			(void)assert_wait_deadline((event_t)&hg_bright_ev, THREAD_UNINT, deadline);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		if (want > 255u) {
+			want = 255u;
+		}
+		/*
+		 * AppleARMBacklight maps iOS linear slider x to level = sqrt(x)*255 (for sRGB pixel scaling),
+		 * so duty = (level/255)^2 recovers linear luminance. s6e3hf4 AOR off-lines = 12 (max) .. 2520 (min).
+		 */
+		uint32_t duty_q = want * want;
+		uint32_t off = 2520u - (duty_q * 2508u) / 65025u;
+		if (off < 12u) {
+			off = 12u;
+		}
+		if (off > 2520u) {
+			off = 2520u;
+		}
+		uint8_t aor[3] = { 0xb1u, (uint8_t)((off >> 8) << 4), (uint8_t)(off & 0xffu) };
+		static const uint8_t key2_on[]  = { 0xf0u, 0x5au, 0x5au };
+		static const uint8_t key3_on[]  = { 0xfcu, 0x5au, 0x5au };
+		static const uint8_t key3_off[] = { 0xfcu, 0xa5u, 0xa5u };
+		static const uint8_t key2_off[] = { 0xf0u, 0xa5u, 0xa5u };
+
+		uint32_t trig = hg_rd(decon, 0x70);
+		hg_wr(decon, 0x70, trig | (1u << 5));           /* mask HW_TRIG during DCS write */
+		for (unsigned t = 0; t < 25000 && (hg_rd(decon, 0x8c) & 0xffff) != 0; t++) {
+			delay(1);
+		}
+		delay(80);
+		bool ok = hg_dsim_dcs_long(dsim, key2_on, sizeof(key2_on)) &&
+		    hg_dsim_dcs_long(dsim, key3_on, sizeof(key3_on)) &&
+		    hg_dsim_dcs_long(dsim, aor, sizeof(aor)) &&
+		    hg_dsim_dcs_short_param(dsim, 0xf7u, 0x03u) &&
+		    hg_dsim_dcs_short_param(dsim, 0xf7u, 0x00u) &&
+		    hg_dsim_dcs_long(dsim, key3_off, sizeof(key3_off)) &&
+		    hg_dsim_dcs_long(dsim, key2_off, sizeof(key2_off));
+		delay(20);
+		hg_wr(decon, 0x70, trig);                       /* unmask HW_TRIG */
+		applied = want;
+		if (++logged <= 25 || !ok) {
+			printf("HEROLTE HWBL: level %u -> AOR off=%u (0x%02x 0x%02x): %s\n",
+			    want, off, aor[1], aor[2], ok ? "ok" : "FAIL");
+		}
+		hg_msleep(16);
+	}
+}
+
 static void
 hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -4264,6 +4357,12 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 		hg_wr(mux_decon, 0x48, 1u << 8);        /* clear any stale FIFO level IRQ before active scan */
 		printf("HEROLTE DISP: vclk on DISP_PLL, status %#x\n", hg_rd(mux_cmu, 0x600));
 	}
+	{
+		thread_t blth = THREAD_NULL;
+		if (kernel_thread_start(hg_bright_thread, NULL, &blth) == KERN_SUCCESS) {
+			thread_deallocate(blth);
+		}
+	}
 	hg_msleep(3000);
 	hg_vgr0_early();
 	hg_msleep(27000);
