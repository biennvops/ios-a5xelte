diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index a591abc..f091a46 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -635,6 +635,59 @@ struct herolte_log_header {
 
 static int herolte_log_chan;
 
+extern void sweet_usb_probe(void);
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+uint64_t sweet_log_position(void);
+void herolte_reboot_recovery(void);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	const char *ring;
+	uint32_t ring_sz;
+	uint64_t ring_tot;
+	a5xelte_log_snapshot(&ring, &ring_sz, &ring_tot);
+	if (!ring || !ring_sz) {
+		return 0;
+	}
+	if (ring_tot - *pos > ring_sz) {
+		*pos = ring_tot - ring_sz;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, ring_tot - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = ring[(*pos + i) % ring_sz];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t
+sweet_log_position(void)
+{
+	const char *ring;
+	uint32_t ring_sz;
+	uint64_t ring_tot;
+	a5xelte_log_snapshot(&ring, &ring_sz, &ring_tot);
+	return ring_tot;
+}
+
+void
+herolte_reboot_recovery(void)
+{
+	vm_offset_t pmu = ml_io_map(0x105c0000u, 0x1000u);
+	printf("HEROLTE: rebooting to TWRP recovery\n");
+	if (pmu) {
+		*(volatile uint32_t *)(pmu + 0x808u) = 0x12345678u;
+		*(volatile uint32_t *)(pmu + 0x80cu) = 0x12345674u;
+		__asm__ volatile("dsb sy" ::: "memory");
+		*(volatile uint32_t *)(pmu + 0x400u) = 1u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
 static void
 herolte_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -817,6 +870,7 @@ herolte_ufs_init(void)
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
 	herolte_log_start();
+	sweet_usb_probe();
 	return 0;
 }
 
