@@ -10,7 +10,7 @@
  * DWC3 / PHY register blocks only when the GCC status registers say their
  * power domain and clocks are on (an access to a gated block would hang).
  */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_HEROLTE)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
@@ -60,8 +60,15 @@ static const struct {
 	{ "clkref", 0x8c010 },
 };
 
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#define DWC3_PA                 0x15400000
+#define DWC3_SIZE               0x00010000
+#define EXYNOS_USBPHY_PA        0x15500000
+#define EXYNOS_PMU_PA           0x105c0000
+#else
 #define DWC3_PA                 0x0a600000
 #define DWC3_SIZE               0x0000d000
+#endif
 #define QUSB2_PA                0x088e2000
 #define QUSB2_SIZE              0x00000400
 
@@ -76,6 +83,42 @@ usb_rd(vm_offset_t base, uint32_t off)
 void
 sweet_usb_probe(void)
 {
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	int enabled = 2;
+	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t pmu = ml_io_map(EXYNOS_PMU_PA, 0x1000);
+	vm_offset_t phy = ml_io_map(EXYNOS_USBPHY_PA, 0x100);
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (!pmu || !phy || !dwc) {
+		printf("HEROLTE USB: map failed\n");
+		return;
+	}
+	*(volatile uint32_t *)(pmu + 0x704) = 1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(phy + 0x14) = 0;
+	*(volatile uint32_t *)(phy + 0x34) = (1u << 9);
+	*(volatile uint32_t *)(phy + 0x04) = (1u << 27) | (0x20u << 1) | (1u << 8) | (1u << 7);
+	*(volatile uint32_t *)(phy + 0x1c) = 0x26f987e0u;
+	*(volatile uint32_t *)(phy + 0x08) = (1u << 6);
+	*(volatile uint32_t *)(phy + 0x28) &= ~((1u << 3) | (1u << 2));
+	uint32_t clkrst = (1u << 31) | (1u << 20) | (1u << 19) | (0x60u << 11) |
+	    (5u << 5) | (1u << 4) | (2u << 2) | (1u << 1) | 1u;
+	*(volatile uint32_t *)(phy + 0x10) = clkrst;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(20);
+	*(volatile uint32_t *)(phy + 0x10) = clkrst & ~(1u << 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("HEROLTE USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x DCFG 0x%08x DCTL 0x%08x DSTS 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc700),
+	    usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc70c));
+	if (enabled >= 2) {
+		sweet_usb_gadget_start(dwc);
+	}
+	return;
+#else
 	int enabled = 1;
 	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
 	bool clocks_on = true;
@@ -132,6 +175,7 @@ sweet_usb_probe(void)
 	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
 	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
 	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+#endif
 }
 
