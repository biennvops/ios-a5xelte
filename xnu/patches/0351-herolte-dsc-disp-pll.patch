diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index de14fdb..14c2fdd 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -1886,9 +1886,12 @@ hfb_setup_locked(void)
 		return;
 	}
 	hfb_idma = hfb_g1 = ml_io_map(HG_IDMA_G1_PA, 0x1000);
-	if (!hfb_idma || hg_rd(hfb_idma, 0xb74) != (uint32_t)HG_FB_PA || hg_rd(hfb_idma, 0x10) != ((HG_PANEL_H << 16) | HG_PANEL_W)) {
-		printf("HEROLTE FB2: G1 reads %#x, size %#x: not the panel as S-Boot left it; one buffer\n",
-		    hfb_idma ? hg_rd(hfb_idma, 0xb74) : 0, hfb_idma ? hg_rd(hfb_idma, 0x10) : 0);
+	uint32_t panel_sz = (HG_PANEL_H << 16) | HG_PANEL_W;
+	if (!hfb_idma || hg_rd(hfb_idma, 0xb74) != (uint32_t)HG_FB_PA ||
+	    (hg_rd(hfb_idma, 0x10) != panel_sz && hg_rd(hfb_idma, 0x18) != panel_sz)) {
+		printf("HEROLTE FB2: G1 reads %#x, size %#x/%#x: not the panel as S-Boot left it; one buffer\n",
+		    hfb_idma ? hg_rd(hfb_idma, 0xb74) : 0, hfb_idma ? hg_rd(hfb_idma, 0x10) : 0,
+		    hfb_idma ? hg_rd(hfb_idma, 0x18) : 0);
 		return;
 	}
 	volatile uint64_t *l2t = (volatile uint64_t *)(hg_mem + 0x2000);
@@ -2271,7 +2274,7 @@ hgp_draw_locked(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h)
 		static int fb_test = -1, dst_chk = -1;
 		static vm_offset_t t_fb1, t_fb2;
 		if (fb_test < 0) {
-			uint32_t t = 0, d = 1;
+			uint32_t t = 0, d = 0;
 			PE_parse_boot_argn("herofb_test", &t, sizeof(t));
 			PE_parse_boot_argn("herodstchk", &d, sizeof(d));
 			fb_test = (int)t;
@@ -3850,10 +3853,32 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 	PE_parse_boot_argn("herodisp", &on_pll, sizeof(on_pll));
 	vm_offset_t mux_cmu = ml_io_map(0x13ad0000u, 0x1000), mux_decon = ml_io_map(0x13960000u, 0x1000);
 	if (on_pll && mux_cmu && mux_decon && !(hg_rd(mux_cmu, 0x200) & (1u << 12))) {
+		/*
+		 * hero2lte (s6e3hf4_wqhd, DSC=2, DECON +0x230 = 0x11): S-Boot leaves DISP_PLL at 62.5 MHz
+		 * (11.3 ms/frame). Writing compressed DSC data into the command-mode OLED's GRAM faster
+		 * than the panel's ~16.3 ms glass scanout overtakes the read pointer and desyncs the DSC
+		 * decoder (white+purple artifacts at ~2% at 62.5 MHz, ~4% at 48 MHz, ~15% at 40 MHz).
+		 * At 38 MHz (M=304, P=13, S=4, VCO=608 MHz), DECON writes in 16.38 ms (< 16.58 ms TE):
+		 * full 60 Hz + VGR0 with zero DSC write-vs-read collision and zero FIFO underrun.
+		 */
+		bool dsc = (hg_rd(mux_decon, 0x230) & 0x11u) == 0x11u;
+		uint32_t mhz = dsc ? 38u : 0u;
+		PE_parse_boot_argn("herodisp_mhz", &mhz, sizeof(mhz));
+		if (mhz >= 38u && mhz <= 63u) {
+			uint32_t con0 = hg_rd(mux_cmu, 0x100);
+			uint32_t m = mhz * 8u;          /* PLL14180 P=13 (Fref=2 MHz), S=4 (/16): VCO=2*M in 608..1008 MHz */
+			uint32_t want = (con0 & ~((0x3ffu << 16) | (0x3fu << 8) | 7u)) | (m << 16) | (13u << 8) | 4u | (1u << 31);
+			hg_wr(mux_cmu, 0x100, want);
+			for (unsigned t = 0; t < 1000 && !(hg_rd(mux_cmu, 0x100) & (1u << 29)); t++) {
+				delay(10);
+			}
+			printf("HEROLTE DISP: DISP_PLL %#x -> %#x (%u MHz%s)\n", con0, hg_rd(mux_cmu, 0x100), mhz, dsc ? ", DSC" : "");
+		}
 		for (unsigned t = 0; t < 100000 && (hg_rd(mux_decon, 0x8c) & 0xffff) != 0; t++) {
 			delay(1);
 		}
 		hg_wr(mux_cmu, 0x200, hg_rd(mux_cmu, 0x200) | (1u << 12));
+		hg_wr(mux_decon, 0x48, 1u << 8);        /* clear any stale FIFO level IRQ before active scan */
 		printf("HEROLTE DISP: vclk on DISP_PLL, status %#x\n", hg_rd(mux_cmu, 0x600));
 	}
 	hg_msleep(3000);
