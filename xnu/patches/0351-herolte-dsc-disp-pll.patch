diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index de14fdb..4339060 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2271,7 +2271,7 @@ hgp_draw_locked(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h)
 		static int fb_test = -1, dst_chk = -1;
 		static vm_offset_t t_fb1, t_fb2;
 		if (fb_test < 0) {
-			uint32_t t = 0, d = 1;
+			uint32_t t = 0, d = 0;
 			PE_parse_boot_argn("herofb_test", &t, sizeof(t));
 			PE_parse_boot_argn("herodstchk", &d, sizeof(d));
 			fb_test = (int)t;
@@ -3850,10 +3850,30 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 	PE_parse_boot_argn("herodisp", &on_pll, sizeof(on_pll));
 	vm_offset_t mux_cmu = ml_io_map(0x13ad0000u, 0x1000), mux_decon = ml_io_map(0x13960000u, 0x1000);
 	if (on_pll && mux_cmu && mux_decon && !(hg_rd(mux_cmu, 0x200) & (1u << 12))) {
+		/*
+		 * Samsung decon_clocks_table (decon_reg_8890.c): 1440x2560 MIC 1:2 (herolte, s6e3ha3) uses
+		 * DISP_PLL = 62.5 MHz, while 1440x2560 DSC=2 (hero2lte, s6e3hf4, DECON +0x230 = 0x11) uses
+		 * 42 MHz. Running DSC at S-Boot's 62.5 MHz triggers DECON IRQ_FIFO_LEVEL underruns (bit 8)
+		 * and white/purple artifacts on the top DSC slice (status bar).
+		 */
+		bool dsc = (hg_rd(mux_decon, 0x230) & 0x11u) == 0x11u;
+		uint32_t mhz = dsc ? 42u : 0u;
+		PE_parse_boot_argn("herodisp_mhz", &mhz, sizeof(mhz));
+		if (mhz >= 38u && mhz <= 63u) {
+			uint32_t con0 = hg_rd(mux_cmu, 0x100);
+			uint32_t m = mhz * 8u;          /* PLL14180 P=13 (Fref=2 MHz), S=4 (/16): VCO=2*M in 608..1008 MHz */
+			uint32_t want = (con0 & ~((0x3ffu << 16) | (0x3fu << 8) | 7u)) | (m << 16) | (13u << 8) | 4u | (1u << 31);
+			hg_wr(mux_cmu, 0x100, want);
+			for (unsigned t = 0; t < 1000 && !(hg_rd(mux_cmu, 0x100) & (1u << 29)); t++) {
+				delay(10);
+			}
+			printf("HEROLTE DISP: DISP_PLL %#x -> %#x (%u MHz%s)\n", con0, hg_rd(mux_cmu, 0x100), mhz, dsc ? ", DSC" : "");
+		}
 		for (unsigned t = 0; t < 100000 && (hg_rd(mux_decon, 0x8c) & 0xffff) != 0; t++) {
 			delay(1);
 		}
 		hg_wr(mux_cmu, 0x200, hg_rd(mux_cmu, 0x200) | (1u << 12));
+		hg_wr(mux_decon, 0x48, 1u << 8);        /* clear any stale FIFO level IRQ before active scan */
 		printf("HEROLTE DISP: vclk on DISP_PLL, status %#x\n", hg_rd(mux_cmu, 0x600));
 	}
 	hg_msleep(3000);
