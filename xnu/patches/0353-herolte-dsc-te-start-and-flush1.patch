+static bool
+hg_dsim_dcs_long(vm_offset_t dsim, const uint8_t *data, unsigned len)
+{
+	hg_wr(dsim, 0x34, (1u << 28) | (1u << 29)); /* clear SFR_PH/PL_FIFO_EMPTY */
+	for (unsigned i = 0; i < len; i += 4) {
+		uint32_t w = data[i];
+		if (i + 1 < len) {
+			w |= (uint32_t)data[i + 1] << 8;
+		}
+		if (i + 2 < len) {
+			w |= (uint32_t)data[i + 2] << 16;
+		}
+		if (i + 3 < len) {
+			w |= (uint32_t)data[i + 3] << 24;
+		}
+		hg_wr(dsim, 0x40, w); /* DSIM_PAYLOAD */
+	}
+	hg_wr(dsim, 0x3c, 0x39u | ((len & 0xffu) << 8) | (((len >> 8) & 0xffu) << 16)); /* DSIM_PKTHDR: DCS long write */
+	for (unsigned t = 0; t < 5000; t++) {
+		if (hg_rd(dsim, 0x34) & (1u << 28)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
